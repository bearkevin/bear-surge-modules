#!name = Bear DIRECT Module
#!desc = Use DIRECT rule when connecting to the specified Wi-Fi
#!category = Bear

[Rule]
# MTProto Server 转发的 DC 连接为纯 IP 连接，用协议规则显式接管（需 iOS 5.21+ / macOS 6.8+）
PROTOCOL,MTProto,Telegram #!REQUIREMENT SYSTEM!='tvOS'
# > Proxy SUBNET
# 2026-10 LAN renumber: 192.168.x -> 10.8x; keep old ROUTER entries until migration cleanup (C2)
OR,((AND,((SUBNET,ROUTER:192.168.100.250), (SUBNET,SSID:OurHome))), (AND,((SUBNET,ROUTER:192.168.10.250), (SUBNET,SSID:Bear))), (AND,((SUBNET,ROUTER:10.82.10.250), (SUBNET,SSID:OurHome))), (AND,((SUBNET,ROUTER:10.81.10.250), (SUBNET,SSID:Bear)))),DIRECT
